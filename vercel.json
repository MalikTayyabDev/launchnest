{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "launch-nest.com" }],
      "destination": "https://www.launch-nest.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "launch-nest.com" }],
      "destination": "https://www.launch-nest.com/:path*",
      "statusCode": 301
    }
  ]
}
