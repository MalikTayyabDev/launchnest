# Copy to .env and fill in real values.

# Payload secret used to sign auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Postgres connection string (Neon recommended).
# Neon example: postgres://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# Vercel Blob read/write token for media uploads in production (required on Vercel).
# Format must be: vercel_blob_rw_<storeId>_<secret>
# Create: Vercel dashboard → Storage → Blob → connect to this project.
# Token is usually injected automatically as BLOB_READ_WRITE_TOKEN.
# Optional: Blob store id ONLY (example: n8abscuqkk8r6asr).
# Do NOT include the "store_" prefix — public URLs are:
#   https://n8abscuqkk8r6asr.public.blob.vercel-storage.com/...
# Vercel → Storage → Blob → copy the id without "store_".
BLOB_STORE_ID=

# Canonical public URL of the site (no trailing slash). Used for CORS/CSRF, SEO, and sitemap.
NEXT_PUBLIC_SERVER_URL=https://www.launch-nest.com

# Optional: forward qualified leads to an external CRM webhook as well.
CRM_WEBHOOK_URL=

# Lead notification emails via your launch-nest.com webmail (SMTP).
# Get host/port from your email host (cPanel / hosting panel → Email → Configure client).
# Leave SMTP_PASS blank to disable sending (Payload logs attempts to the console).
SMTP_HOST=mail.launch-nest.com
SMTP_PORT=465
# true = SSL (465). Set to false for STARTTLS on port 587.
SMTP_SECURE=true
SMTP_USER=solutions@launch-nest.com
SMTP_PASS=
# Inbox that receives lead notifications (usually the same mailbox).
LEAD_NOTIFICATION_EMAIL=solutions@launch-nest.com
# Address notifications are sent FROM (must be allowed by your SMTP account).
EMAIL_FROM=solutions@launch-nest.com
EMAIL_FROM_NAME=LaunchNest

# Optional: auto-screenshot provider for the Projects collection.
# Leave blank to use the free, keyless provider (thum.io).
# For higher quality + ad/cookie-banner blocking, add a ScreenshotOne key:
#   https://screenshotone.com  ->  Dashboard  ->  Access key
SCREENSHOTONE_ACCESS_KEY=
# Force the free provider even when a key is set (values: thumio)
SCREENSHOT_PROVIDER=
